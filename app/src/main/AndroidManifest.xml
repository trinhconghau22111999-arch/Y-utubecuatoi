<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Giữ CPU không ngủ khi màn hình tắt trong lúc đang phát video/nhạc - xem WakeLockBridge
         trong MainActivity.kt. Không giữ SÁNG màn hình (không dùng FLAG_KEEP_SCREEN_ON) - màn
         hình vẫn tắt bình thường, chỉ có CPU/âm thanh là tiếp tục chạy. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Service loại "phát media nền" - giúp hệ thống KHÔNG đóng băng tiến trình
         app khi màn hình tắt (đây mới là nguyên nhân chính khiến video/nhạc bị dừng hẳn khi tắt
         màn hình, không phải do JS). Kèm 1 thông báo nhỏ báo đang phát nền. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cho phép app tự mở hộp thoại hệ thống xin người dùng đưa app vào danh sách "không tối
         ưu hoá pin" - nhiều hãng (Xiaomi/Oppo/Vivo...) vẫn có thể kill app dù đã có Foreground
         Service nếu app không nằm trong whitelist pin này. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Cần khai báo để app có thể "nhìn thấy" và gọi được activity nhận dạng
         giọng nói của hệ thống trên Android 11+ (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NoActionBar"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:allowAudioPlaybackCapture="true">

        <!-- allowAudioPlaybackCapture: từ Android 10 (API 29) trở lên, giá trị mặc định của cờ
             này là FALSE với mọi app có targetSdk >= 29 (app này đang targetSdk 34) - nghĩa là
             MẶC ĐỊNH, hệ thống KHÔNG cho phép bất kỳ ai (kể cả chính app này) tự bắt lại âm thanh
             app đang phát ra qua AudioPlaybackCaptureConfiguration, dù build config có thành công,
             AudioRecord vẫn chỉ đọc được toàn số 0 (im lặng) chứ không ném lỗi rõ ràng nào - đây
             là nguyên nhân file quay ra không có tiếng dù pipeline MediaCodec/AudioRecord/MediaMuxer
             trong ScreenRecordService đã đúng. Bật true để CHO PHÉP tự capture âm thanh CỦA CHÍNH
             APP MÌNH (không liên quan/không ảnh hưởng gì đến việc app khác có bắt được âm thanh
             của app này hay không). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">

        </service>
        <service
            android:name=".ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
